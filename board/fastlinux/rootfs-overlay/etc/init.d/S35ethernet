#!/bin/sh
case "$1" in
 start)
  printf 'nameserver 84.2.44.8\nnameserver 84.2.46.8\n' > /run/resolv.conf
  (
   n=0
   while [ "$n" -lt 100 ]; do
    for p in /sys/class/net/*; do
     dev="${p##*/}"
     [ "$dev" = lo ] && continue
     [ -d "$p/wireless" ] && continue
     ip link set "$dev" up
     ip address replace 192.168.0.234/24 dev "$dev"
     ip route replace default via 192.168.0.1 dev "$dev"
     echo "Static Ethernet ready: $dev 192.168.0.234/24"
     exit 0
    done
    sleep 0.2; n=$((n+1))
   done
   echo 'Ethernet device did not appear' >&2
   exit 1
  ) >>/tmp/ethernet.log 2>&1 &
  ;;
 stop) :;;
esac
