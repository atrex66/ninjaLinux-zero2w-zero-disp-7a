CONFIG_LOCALVERSION="-fastlinux"
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_EXPERT=y
# CONFIG_MODULES is not set
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_BCM2835_MBOX=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=128
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_VC4_HDMI_CEC is not set
CONFIG_SND=y
CONFIG_SND_SOC=y
# CONFIG_SND_BCM2835 is not set
# CONFIG_SND_USB_AUDIO is not set
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
# CONFIG_USB_DWC2_DUAL_ROLE is not set
# CONFIG_USB_GADGET is not set
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT_EVDEV=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_USB_NET_DRIVERS=y
# CONFIG_USB_USBNET is not set
# CONFIG_USB_NET_SMSC95XX is not set
# CONFIG_USB_NET_DM9601 is not set
# CONFIG_USB_NET_SR9700 is not set
# CONFIG_USB_NET_SR9800 is not set
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
CONFIG_USB_RTL8152=y
# CONFIG_USB_NET_CDCETHER is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_NFC is not set
# CONFIG_CAN is not set
# CONFIG_PPP is not set
# CONFIG_INFINIBAND is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_I915 is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_KUNIT is not set
# CONFIG_KASAN is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_GPIO_CDEV=y
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

CONFIG_MMC_BCM2835_MMC=y
CONFIG_BCM2835_POWER=y
CONFIG_BCM2835_THERMAL=y

# CONFIG_USB_DWCOTG is not set
# Board services that must not disappear when loadable modules are disabled.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PINCTRL_BCM2835=y
CONFIG_DMA_BCM2835=y
# Controllers absent from Zero 2 W.
# CONFIG_PCI is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_FB_BCM2708 is not set
# CONFIG_LOGO is not set

# Keep only the ALSA core selected by VC4, without audio device families.
# CONFIG_SND_OSSEMUL is not set
# CONFIG_SND_SEQUENCER is not set
# CONFIG_SND_RAWMIDI is not set
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_COMPRESS_OFFLOAD is not set
# CONFIG_SND_HWDEP is not set
# CONFIG_SND_VERBOSE_PROCFS is not set
# CONFIG_ETHERNET is not set
# CONFIG_NETFILTER is not set
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y
# No legacy VPU audio/video service is needed by Mesa VC4.
# CONFIG_BCM2835_VCHIQ is not set
# Direct SD boot uses only ext4 plus FAT; no network/alternate root stacks.
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_NFSD is not set
# CONFIG_F2FS_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_CONFIGFS_FS is not set
# CONFIG_EFI is not set
# CONFIG_PSTORE is not set
# CONFIG_IP_PNP is not set
