config BR2_PACKAGE_PYTHON_PYSIDE6
 bool "PySide6 runtime for the appliance Qt build"
 depends on BR2_PACKAGE_PYTHON3
 depends on BR2_PACKAGE_QT6BASE_GUI && BR2_PACKAGE_QT6BASE_WIDGETS
 depends on BR2_PACKAGE_QT6BASE_OPENGL && BR2_PACKAGE_QT6BASE_NETWORK
 select BR2_PACKAGE_PYTHON_SHIBOKEN6
config BR2_PACKAGE_PYTHON_SHIBOKEN6
 bool
